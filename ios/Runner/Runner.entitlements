<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Sep 12 2026: this was missing entirely. This is the actual,
	     compiled-in record of the Push Notifications capability --
	     whatever was done in Xcode's Signing & Capabilities tab back
	     in build 227 never actually got saved into this file, so every
	     build since (227 through 230) was compiled WITHOUT push
	     capability, regardless of how correctly the Firebase/APNs
	     console side was configured. This is very likely the real
	     root cause of zero device tokens ever registering and no
	     "Notifications" row ever appearing in iOS Settings for this
	     app, on any account, on any build: without this entitlement,
	     iOS has no basis to let the app register for push at all.
	     Xcode's automatic signing substitutes the correct value
	     (development vs production) at archive time based on the
	     provisioning profile actually used -- this is the standard,
	     same entitlement Xcode's own "Push Notifications" capability
	     checkbox adds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
